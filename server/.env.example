PORT=8080
ALLOW_LOCALHOST_AUTH_BYPASS=false
VEHICLE_AUTH_TOKEN=replace-with-a-long-random-vehicle-token
CONTROLLER_AUTH_TOKEN=replace-with-a-long-random-controller-token
RATE_LIMIT_MAX_MESSAGES=600
CAMERA_FRAME_MIN_INTERVAL_MS=70
CAMERA_FRAME_MAX_BYTES=200000
CAMERA_CONTROLLER_MAX_BUFFERED_BYTES=128000
CAMERA_RENDER_ACK_TIMEOUT_MS=900
WIFI_UPDATE_ACK_TIMEOUT_MS=3500
CAMERA_LIVENESS_TIMEOUT_MS=10000
VEHICLE_LIVENESS_TIMEOUT_MS=8000
CAMERA_LIVENESS_CHECK_INTERVAL_MS=2000
